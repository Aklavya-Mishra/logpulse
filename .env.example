# LogPulse Configuration

# LLM Settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
LLM_PROVIDER=ollama
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Database
DATABASE_URL=sqlite+aiosqlite:///./logpulse.db

# Ingestion
LOG_SOURCE=simulator
LOG_FILE_PATH=/var/log/app.log
SIMULATOR_INTERVAL_MS=500
SIMULATOR_SPIKE_PROBABILITY=0.05

# Anomaly Detection
ZSCORE_WINDOW_SIZE=60
ZSCORE_THRESHOLD=2.5
ERROR_RATE_THRESHOLD=0.3
LLM_ENRICHMENT_TIMEOUT_SECONDS=30

# Alerting
WEBHOOK_RECEIVER_URL=http://localhost:8000/webhook/receiver

# Dashboard
DASHBOARD_TITLE=LogPulse - Intelligent Observability
